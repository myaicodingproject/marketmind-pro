# MarketMind Pro Environment Configuration
# Copy this file to .env and update with your actual values

# Database Configuration (Primary)
DATABASE_URL=postgresql://marketmind:password@localhost:5432/marketmind_pro

# Alternative database environment variables (fallback options)
# POSTGRES_URL=postgresql://marketmind:password@localhost:5432/marketmind_pro
# DB_URL=postgresql://marketmind:password@localhost:5432/marketmind_pro

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Application Settings
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# API Keys
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here
SEC_EDGAR_USER_AGENT=MarketMind Pro support@marketmind.com

# Security
SECRET_KEY=your-secret-key-change-in-production
JWT_SECRET_KEY=your-jwt-secret-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Server Configuration
HOST=0.0.0.0
PORT=8000
WORKERS=4

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Cache Settings
CACHE_TTL_SECONDS=900

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Report Generation
MAX_CONCURRENT_REPORTS=5
REPORT_TIMEOUT_MINUTES=30
REPORTS_DIR=./reports

# Quality Gates
MIN_CONTENT_LENGTH=200
MIN_QUALITY_SCORE=75.0

# WebSocket Settings
WEBSOCKET_PING_INTERVAL=30
WEBSOCKET_PING_TIMEOUT=10
WEBSOCKET_TIMEOUT=300

# File Storage
DATA_DIR=./data
STATIC_DIR=./static

# Retry Settings
MAX_RETRIES=2